          "items": [
            { "title": "Generative Weight Synthesis", "text": "Generating neural network weights with diffusion, flow matching, and autoregressive models, conditioned on architecture or task.", "tags": "Diffusion, Flow matching, Autoregressive" },
            { "title": "Latent Representations of Model Weights", "text": "Encoding pretrained weights into structured latent spaces with VAEs and autoencoders, as a basis for generation, merging, and analysis.", "tags": "VAE, Representation learning" },
            { "title": "Latent-Space Model Merging", "text": "Merging models in a learned latent space with optimal transport alignment (LS-Merge), extended toward mixture-of-experts compression.", "tags": "Model merging, Optimal transport, MoE" },
            { "title": "Configuration-to-Weights Generation", "text": "Synthesizing weights directly from architectural specifications, with transfer across model families and scales.", "tags": "AutoML, Cross-architecture transfer" }
